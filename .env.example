# --- AWS / dữ liệu ---
S3_BUCKET=uet-pdf-watermark
AWS_REGION=ap-southeast-1
# Local: để trống sẽ dùng SQLite. Trên AWS: dùng RDS PostgreSQL
# DB_URL=postgresql://postgres:MAT_KHAU@pdf-watermark-db.xxxx.ap-southeast-1.rds.amazonaws.com:5432/watermark_db
CACHE_DIR=/tmp/wm_cache
CACHE_TTL_HOURS=6
WORKERS=2

# --- Giới hạn (chỉ trình duyệt kiểm tra) ---
MAX_PDF_MB=10
MAX_LOGO_KB=200
MAX_CSV_ROWS=300
MAX_PARALLEL=6
MAX_RETRIES=2

# --- Watermark ---
FONT_PATH=fonts/DejaVuSans.ttf
WM_ANGLE=45
WM_FONTSIZE=30
WM_SUB_RATIO=0.45
WM_OPACITY=0.2
LOGO_WIDTH=80
LOGO_HEIGHT=50
LOGO_MARGIN=20
