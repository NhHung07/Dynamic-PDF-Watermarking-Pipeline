# Cấu hình Database (RDS MySQL hoặc PostgreSQL, mặc định fallback về SQLite)
# DB_URL=mysql+pymysql://username:password@rds-endpoint:3306/dbname
# DB_URL=postgresql://username:password@rds-endpoint:5432/dbname
DB_URL=sqlite:////tmp/audit.db

# Cấu hình AWS S3 & EFS
S3_BUCKET=uet-pdf-watermark
EFS_DIR=/mnt/efs
AWS_REGION=ap-southeast-1

# Cấu hình AWS Credentials (nếu không dùng IAM Role hoặc hung_credentials.csv)
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
